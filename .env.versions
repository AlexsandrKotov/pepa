# Tool versions — single source of truth.
# Read by Makefile, build-production.sh, CI workflows, and Docker Compose.
# Update here; all consumers pick up automatically.

HELM_VERSION=v4.2.4
OPENTOFU_VERSION=1.9.0
TRIVY_VERSION=0.74.0

# Container image versions.
POSTGRES_IMAGE=pgvector/pgvector:pg18
REDIS_IMAGE=redis:7.4-alpine
NGINX_IMAGE=nginx:1.31-alpine
# PEPA images: set to release tag (e.g., v0.1.0) or digest for production.
# Default: latest for local dev; CI/release pipelines override with pinned version.
PEPA_IMAGE_TAG=latest
