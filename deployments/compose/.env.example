# ============================================================
# PEPA — Docker Compose Environment
# ============================================================
# Copy this file to .env and customize for your environment:
#   cp .env.example .env
#
# The .env file is gitignored — NEVER commit real credentials.
# ============================================================

# ── Container Image Versions ────────────────────────────────
# Pin image versions for production deployments.
# Default values use :latest for local development.
# For production, set PEPA_IMAGE_TAG to a release tag (e.g., v0.1.0)
# or a digest (e.g., sha256:abc123...) for reproducibility.
POSTGRES_IMAGE=pgvector/pgvector:pg18
REDIS_IMAGE=redis:7.4-alpine
NGINX_IMAGE=nginx:1.31-alpine
PEPA_IMAGE_TAG=latest

# ── Server ───────────────────────────────────────────────────
SERVER_ENV=production

# ── Profiling (pprof) ────────────────────────────────────────
# Enable pprof for production debugging (disabled by default).
# WARNING: pprof exposes runtime internals — do NOT expose publicly.
SERVER_PPROF_ENABLED=false
SERVER_PPROF_PORT=6060

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_DB=pepa
POSTGRES_USER=pepa
POSTGRES_PASSWORD=pepa_dev
POSTGRES_PORT=5432

# Application role — non-superuser subject to RLS policies.
# The app connects as this role for runtime queries; migrations
# still run as POSTGRES_USER (owner). Leave empty to disable.
# Generate a strong password: openssl rand -hex 16
APP_POSTGRES_USER=pepa_app
APP_POSTGRES_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex

# ── Redis ────────────────────────────────────────────────────
REDIS_PASSWORD=pepa_dev
REDIS_PORT=6379

# ── S3 Storage (optional) ──────────────────────────────────
# Leave empty to use local filesystem storage (default).
# Uncomment and fill in to enable external S3/MinIO:
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# ── Authentication ───────────────────────────────────────────
# JWT secret for signing tokens (change in production!)
AUTH_JWT_SECRET=pepa-dev-jwt-secret

# Bootstrap token file path (written once on first run, expires in 1h).
# Default: /var/run/pepa/bootstrap_token.txt
# Read it with: docker exec pepa-api cat /var/run/pepa/bootstrap_token.txt
# BOOTSTRAP_TOKEN_PATH=/var/run/pepa/bootstrap_token.txt

# ── Encryption ───────────────────────────────────────────────
# Master key for encrypting vault secrets and credentials at rest.
# MUST be consistent across restarts — changing it makes all
# existing encrypted data unreadable.
# Generate a strong key: openssl rand -hex 32
ENCRYPTION_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

# ── Docker ──────────────────────────────────────────────────
# Set to the host path of the Docker socket to enable Docker host management.
# WARNING: This gives the API container full control over the Docker daemon.
# Default: /dev/null (disabled). Set to /var/run/docker.sock only if needed.
MOUNT_DOCK_SOCKET=/dev/null

# ── Ports (host mapping) ────────────────────────────────────
API_PORT=8088
FRONTEND_PORT=3000

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:8088

# ── Plugin Signature Verification ───────────────────────────
# Verify Ed25519 signatures of plugin binaries before loading.
# Set to "true" in production to ensure only signed plugins run.
PLUGIN_SIGNATURE_VERIFY=true
# Enforce mode: reject unsigned plugins entirely (requires VERIFY=true).
PLUGIN_SIGNATURE_ENFORCE=true

# ── Resource Limits (optional) ───────────────────────────────
# Docker resource limits per service. Adjust based on your server capacity.
# API_CPUS_LIMIT=2.0
# API_MEMORY_LIMIT=1G
# WORKER_CPUS_LIMIT=1.0
# WORKER_MEMORY_LIMIT=512M
# FRONTEND_CPUS_LIMIT=0.5
# FRONTEND_MEMORY_LIMIT=256M
# POSTGRES_CPUS_LIMIT=2.0
# POSTGRES_MEMORY_LIMIT=2G
# REDIS_CPUS_LIMIT=0.5
# REDIS_MEMORY_LIMIT=256M
# NGINX_CPUS_LIMIT=0.5
# NGINX_MEMORY_LIMIT=128M

# ── IaC Projects ──────────────────────────────────────────────
# The host home directory is mounted read-only at /host-home in the container.
# This lets IaC engines access local Ansible/Terraform projects by their host
# path (e.g. /Users/you/projects/ansible). Auto-detected from $HOME.
# Override only if your projects live outside $HOME.
# HOST_HOME_DIR=/custom/path

# ── IaC Binary ───────────────────────────────────────────────
# Override the IaC CLI binary used by Terraform/Ansible engines.
# Auto-detected if empty: tofu > terraform.
# IAC_BINARY=

# ── SonarQube report collection (optional) ───────────────────
# PEPA does not analyse code itself: SonarQube runs in your CI or on its own
# host, and PEPA collects its latest analysis over REST. The SonarQube URL and
# token are configured in Connections (type: SonarQube), never here.
#
# Timeout for collecting one report (a few API calls, not a scan).
# Accepts a Go duration (90s, 2m) or plain seconds.
SONAR_SCAN_TIMEOUT=2m
# Freshness budget for targets without their own stale_after_hours.
SONAR_DEFAULT_STALE_HOURS=24
# Shared secret for POST /api/v1/security/sonar/webhook (header
# X-PEPA-Signature). While empty the endpoint answers 503 and report collection
# runs on schedules only. Set the same value in SonarQube:
#   sonar.webhooks.<n>.secret=<this value>
SONAR_WEBHOOK_TOKEN=

# ── Observability (Optional) ─────────────────────────────────
# PEPA exports traces/logs/metrics via OTLP directly to your backend.
# Set OTEL_ENABLED=true and OTEL_ENDPOINT to your collector/backend.
# Examples: SigNoz (signoz:4317), Grafana Tempo, Grafana Cloud, etc.
# OTEL_ENABLED=false
# OTEL_ENDPOINT=
# OTEL_SERVICE_NAME=pepa
# OTEL_SAMPLING_RATE=1.0
# OTEL_INSECURE=true
