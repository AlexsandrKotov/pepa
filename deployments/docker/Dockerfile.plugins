# PEPA Plugins — plugin binaries + manifests.
#
# Build context must contain pre-built binaries at:
#   plugins/bin-<arch>/<name>              (flat binaries, no subdirectories)
#   plugins/builtin/<name>/plugin.yaml     (manifests)
#
# Note: Plugin signatures are verified in the CI 'plugins' job via
# 'make verify-plugins' before this image is built.
#
# Build args:
#   TARGETARCH — target architecture (amd64/arm64), set automatically by buildx
#
# Usage (CI):
#   docker buildx build --platform linux/amd64,linux/arm64 \
#     -f deployments/docker/Dockerfile.plugins \
#     -t ghcr.io/<owner>/<repo>/pepa-plugins:<tag> --push .

FROM alpine:3.24

ARG TARGETARCH

LABEL org.opencontainers.image.title="PEPA Plugins" \
      org.opencontainers.image.description="Built-in and community plugin binaries with manifests" \
      org.opencontainers.image.vendor="PEPA" \
      org.opencontainers.image.source="https://github.com/AlexsandrKotov/pepa"

RUN apk add --no-cache ca-certificates bash

# Plugin binaries for this architecture (flat structure: bin/<name>)
COPY plugins/bin-${TARGETARCH}/ /plugins/bin/

# Plugin manifests (shared across architectures)
COPY plugins/builtin/ /plugins/builtin/
