FROM golang:1.26-alpine AS builder
RUN apk add --no-cache git
WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /out/worker ./cmd/worker

FROM gcr.io/distroless/static-debian12
LABEL org.opencontainers.image.title="PEPA Worker" \
      org.opencontainers.image.description="Platform Engineering & Pipeline Automator — Background Worker" \
      org.opencontainers.image.vendor="PEPA" \
      org.opencontainers.image.source="https://github.com/AlexsandrKotov/pepa"

WORKDIR /home/nonroot
COPY --from=builder /out/worker /worker
# Plugins are NOT baked into the image.
# Mount ./plugins:/plugins via docker-compose or copy binaries at runtime.
USER nonroot:nonroot
ENTRYPOINT ["/worker"]
