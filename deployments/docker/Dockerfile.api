# Stage 1: Helm binary (cached independently of Go code)
FROM alpine:3.24 AS helm
ARG HELM_VERSION=v4.2.4
ARG TARGETARCH
RUN apk add --no-cache curl && \
    ARCH=$(if [ "$TARGETARCH" = "arm64" ]; then echo "arm64"; else echo "amd64"; fi) && \
    curl -fsSLo helm.tar.gz "https://get.helm.sh/helm-${HELM_VERSION}-linux-${ARCH}.tar.gz" && \
    tar -xzf helm.tar.gz -C /tmp && \
    mv /tmp/linux-${ARCH}/helm /usr/local/bin/helm && \
    rm -rf helm.tar.gz /tmp/linux-${ARCH}

# Stage 1b: OpenTofu binary (open-source Terraform fork, MPL 2.0)
FROM alpine:3.24 AS opentofu
ARG OPENTOFU_VERSION=1.9.0
ARG TARGETARCH
RUN apk add --no-cache curl unzip && \
    ARCH=$(if [ "$TARGETARCH" = "arm64" ]; then echo "arm64"; else echo "amd64"; fi) && \
    curl -fsSLo tofu.zip "https://github.com/opentofu/opentofu/releases/download/v${OPENTOFU_VERSION}/tofu_${OPENTOFU_VERSION}_linux_${ARCH}.zip" && \
    unzip tofu.zip -d /tmp && \
    mv /tmp/tofu /usr/local/bin/tofu && \
    chmod +x /usr/local/bin/tofu && \
    rm -rf tofu.zip /tmp/*

# Stage 1c: Trivy binary (security scanner for the trivy plugin)
FROM alpine:3.24 AS trivy
ARG TRIVY_VERSION=0.74.0
ARG TARGETARCH
RUN apk add --no-cache curl && \
    ARCH=$(if [ "$TARGETARCH" = "arm64" ]; then echo "ARM64"; else echo "64bit"; fi) && \
    curl -fsSLo trivy.tar.gz "https://github.com/aquasecurity/trivy/releases/download/v${TRIVY_VERSION}/trivy_${TRIVY_VERSION}_Linux-${ARCH}.tar.gz" && \
    tar -xzf trivy.tar.gz -C /tmp && \
    mv /tmp/trivy /usr/local/bin/trivy && \
    chmod +x /usr/local/bin/trivy && \
    rm -rf trivy.tar.gz /tmp/*

# Stage 2: Go builder
FROM golang:1.26-alpine AS builder
RUN apk add --no-cache git
WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /out/api-server ./cmd/api-server

# Stage 3: Runtime — Alpine with Docker CLI for Docker host management
FROM alpine:3.24
LABEL org.opencontainers.image.title="PEPA API Server" \
      org.opencontainers.image.description="Platform Engineering & Pipeline Automator — API Server" \
      org.opencontainers.image.vendor="PEPA" \
      org.opencontainers.image.source="https://github.com/AlexsandrKotov/pepa"

RUN apk add --no-cache ca-certificates docker-cli docker-cli-compose curl bash openssl git python3 py3-pip && \
    pip3 install --break-system-packages --no-cache ansible-core && \
    mkdir -p /plugins/bin /plugins/builtin /custom-plugins /var/run/pepa && \
    addgroup -S pepa && adduser -S pepa -G pepa && \
    chown -R pepa:pepa /plugins /custom-plugins /var/run/pepa

COPY --from=helm /usr/local/bin/helm /usr/local/bin/helm
COPY --from=opentofu /usr/local/bin/tofu /usr/local/bin/tofu
COPY --from=trivy /usr/local/bin/trivy /usr/local/bin/trivy
COPY --from=builder /out/api-server /api-server

USER pepa:pepa
EXPOSE 8080
ENTRYPOINT ["/api-server"]
