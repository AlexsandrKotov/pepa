# Dependencies
frontend/node_modules/

# Build output
frontend/.next/
frontend/out/
bin/
dist/
.next/
out/
*.tsbuildinfo

# Compiled binaries at repo root
/api-server
/cli
/worker
/email
/webhook
/prometheus
/examples

# Environment files (NEVER commit secrets)
.env
.env.local
.env.*.local
deployments/compose/.env

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Go
*.exe
*.test
*.out
vendor/

# Logs
*.log

# Plugin binaries
plugins/*.so
plugins/*.dll

# Kubeconfig files (may contain credentials)
kubeconfig*
*.kubeconfig

# Coverage
coverage/
*.cover
*.prof

# Never commit local credentials
**/.credentials.txt
*.credentials.txt

# Backup / bundle files
*.bundle
pepa-backup-*/

# Compiled binaries
/proxmox

# Temporary files
tmp/

# Test / dev data
wipe-data.sql
overlays/

# Local plugins
custom-plugins/

# Plugin signing — private key must NEVER be committed
*-private.pem

# Plugin signature artifacts (generated by make sign-plugins)
# Binary checksums are build artifacts — not committed
plugins/bin/**/checksum
plugins/bin/**/checksum.sig
# plugin.yaml.checksum IS committed (needed for CI verification)

# Premium plugins (commercial - not public)
plugins/premium/
plugins/premium-bin/

# Generated diagrams
docs/diagrams/

# Qoder / tool plans
.qoder/
