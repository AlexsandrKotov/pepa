# ============================================================
# PEPA — Environment Configuration
# Copy to .env and adjust values for your environment
# ============================================================

# ── Server ───────────────────────────────────────────────────
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
SERVER_ENV=development
LOG_LEVEL=info

# ── Authentication ───────────────────────────────────────────
# JWT secret for signing tokens (change in production!)
AUTH_JWT_SECRET=pepa-dev-jwt-secret
# Encryption key for credentials/vault secrets at rest (must be consistent across restarts)
# If not set, falls back to AUTH_JWT_SECRET, then JWT_SECRET
ENCRYPTION_KEY=a3f1b8c9d7e2f4a5b6c8d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0
# Set to "true" to skip JWT auth (development only)
DEV_MODE=true

# ── Social OAuth (Optional) ─────────────────────────────────
# Google OAuth — create credentials at console.cloud.google.com
# GOOGLE_OAUTH_ENABLED=false
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URL=http://localhost:8088/api/v1/auth/google/callback

# GitHub OAuth — create an OAuth App at github.com/settings/developers
# GITHUB_OAUTH_ENABLED=false
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URL=http://localhost:8088/api/v1/auth/github/callback

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pepa
POSTGRES_USER=pepa
POSTGRES_PASSWORD=pepa_dev
# Or use a full connection URL:
# DATABASE_URL=postgres://pepa:pepa_dev@localhost:5432/pepa?sslmode=disable

# ── Redis ────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=pepa_dev
# Or use a full URL:
# REDIS_URL=redis://:pepa_dev@localhost:6379/0

# ── MinIO / S3 ──────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
MINIO_BUCKET=pepa
MINIO_USE_SSL=false

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:8088

# ── Plugin Configuration ─────────────────────────────────────
PLUGIN_DIR=./plugins
PLUGIN_MAX_INSTANCES=50
# Verify plugin binaries against the embedded Ed25519 public key on load.
# On by default; an invalid signature logs a warning but still loads.
PLUGIN_SIGNATURE_VERIFY=true
# Refuse to load plugins whose signature check fails. Enable in production.
# PLUGIN_SIGNATURE_ENFORCE=true

# ── AI / RAG (Optional) ─────────────────────────────────────
# AI_ENABLED=false
# AI_PROVIDER=openai
# AI_OPENAI_API_KEY=sk-...
# AI_OLLAMA_URL=http://localhost:11434

# ── Observability (Optional) ─────────────────────────────────
# OTEL_ENABLED=false
# OTEL_EXPORTER=otlp
# OTEL_ENDPOINT=localhost:4317
# OTEL_SERVICE_NAME=pepa-api
# OTEL_SAMPLING_RATE=1.0
# OTEL_INSECURE=true
#
# Syslog forwarding (send logs to remote syslog server)
# SYSLOG_ENABLED=false
# SYSLOG_NETWORK=udp
# SYSLOG_ADDRESS=syslog-server:514
# SYSLOG_TAG=pepa
# SYSLOG_FACILITY=local0
